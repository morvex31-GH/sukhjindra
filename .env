# ---- REQUIRED in production --------------------------------------------------
# PostgreSQL connection string (Neon / Supabase / any Postgres). Keep it SECRET.
DATABASE_URL=postgresql://neondb_owner:npg_qFoOl49hTpQS@ep-icy-forest-bio3d970-pooler.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Refuse to boot without DATABASE_URL, so the site can never silently fall back
# to a wipeable local file and reset your content.
REQUIRE_PERSISTENT_DB=1

# Long random string; keeps admins logged in across restarts. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ---- Recommended -------------------------------------------------------------
# Password for the FIRST-EVER 'admin' account only (ignored once the account exists).
ADMIN_INITIAL_PASSWORD=choose-a-strong-password
# Mark the login cookie HTTPS-only (turn on whenever the site is served over https).
COOKIE_SECURE=1
